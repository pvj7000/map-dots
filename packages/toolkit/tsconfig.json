{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": "../..",
    "paths": {
      "@dotmap/core": ["packages/core/src/index.ts"],
      "@dotmap/theme": ["packages/theme/src/index.ts"],
      "@dotmap/world": ["packages/world/src/index.ts"],
      "@dotmap/react": ["packages/react/src/index.ts"],
      "@dotmap/element": ["packages/element/src/index.ts"]
    }
  },
  "include": [
    "src",
    "../core/src",
    "../theme/src",
    "../react/src",
    "../element/src",
    "../world/src"
  ]
}
