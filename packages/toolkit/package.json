{
  "name": "@dotmap/toolkit",
  "version": "0.1.0-beta.1",
  "description": "Custom dotted maps for the web: engine, React, web component, and portable presets",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pvj7000/map-dots.git",
    "directory": "packages/toolkit"
  },
  "homepage": "https://pvj7000.github.io/map-dots/",
  "bugs": "https://github.com/pvj7000/map-dots/issues",
  "keywords": [
    "map",
    "dots",
    "svg",
    "react",
    "web-component",
    "geojson"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    },
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./world": {
      "types": "./dist/world.d.ts",
      "import": "./dist/world.js"
    },
    "./styles.css": "./dist/styles.css",
    "./browser.js": "./dist/browser.js",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/element.js",
    "./dist/browser.js",
    "./dist/styles.css"
  ],
  "scripts": {
    "build": "node scripts/prepare-build.mjs && tsup && node scripts/finish-build.mjs",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "@types/geojson": "^7946.0.16"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  }
}
